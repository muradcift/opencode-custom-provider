{
  "name": "opencode-custom-provider",
  "version": "0.1.0",
  "description": "Manage custom OpenAI-compatible providers in OpenCode from the command palette",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./tui.tsx"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "tui.tsx",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun build index.ts --outdir dist --target bun --format esm",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "beta",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.8.0"
  }
}
